$block: "skill-section";

// Shared between frontend and editor: visual shell of one skill card
@mixin skill-card {
  width: calc(50% - 10px);
  margin: 0;
  border-radius: 15px;
  border: 1px solid #dcdfe5;
  background: #fff;
  padding: 25px;
}

// Shared between frontend and editor: icon + heading + description grid
@mixin skill-card-content {
  display: grid;
  grid-template-columns: 40px 1fr;
  column-gap: 16px;
  row-gap: 8px;
  margin: 0;

  > * {
    margin: 0;
  }

  .wp-block-image {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
    text-align: left;

    figure {
      margin: 0;
    }

    img {
      display: block;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
      margin: 0;
    }
  }

  .wp-block-heading {
    grid-column: 2;
    grid-row: 1;
    color: #111827;
    font-family: "Poppins", sans-serif;
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
  }

  p {
    grid-column: 2;
    grid-row: 2;
    padding: 0;
    color: #6b7280;
    font-family: "Poppins", sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
  }
}

.#{$block} {
  // For frontend
  &__title {
    margin-bottom: 8px;
    color: #202220;
    font-size: 48px;
    font-style: normal;
    font-weight: 500;
    line-height: 120%;
    margin-top: unset;
  }

  &__description {
    color: #6b7280;
    font-size: 18px;
    font-style: normal;
    font-weight: 400;
    line-height: 34px;
    margin-top: 0;
    margin-bottom: 50px;
  }

  &__block {
    padding: 96px 0;

    .#{$block}__skills {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: space-between;

      > .wp-block-group {
        @include skill-card;

        > .wp-block-group__inner-container {
          @include skill-card-content;
        }
      }
    }
  }

  // For admin panel
  .wp-admin & {
    padding: 20px;
    background-color: #f5f5f5;
    text-align: left;
  }

  // Editor
  .block-editor-inner-blocks {
    width: 100%;
    margin-bottom: 60px;

    > .block-editor-block-list__layout {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;

      > .wp-block-group {
        @include skill-card;

        .wp-block {
          margin: 0;
        }

        > .block-editor-inner-blocks > .block-editor-block-list__layout {
          @include skill-card-content;
        }
      }

      // Button
      .block-list-appender {
        bottom: -60px;
      }
    }
  }
}
